---
// The hero background: a full-screen fragment shader that draws a field of
// parallel lines. Simplex noise makes them drift; the pointer pushes them apart.
---
<canvas class="field" data-line-field aria-hidden="true"></canvas>

<style>
  .field { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>

<script>
  import * as THREE from 'three'

  const FRAG = /* glsl */ `
    precision highp float;
    uniform vec2 uRes;
    uniform float uTime;
    uniform vec2 uMouse;
    uniform float uPush;
    uniform float uReveal;
    uniform vec3 uBg;
    uniform vec3 uLine;

    // Simplex 3D noise (Ashima Arts, MIT)
    vec4 permute(vec4 x){ return mod(((x*34.0)+1.0)*x, 289.0); }
    vec4 taylorInvSqrt(vec4 r){ return 1.79284291400159 - 0.85373472095314 * r; }
    float snoise(vec3 v){
      const vec2 C = vec2(1.0/6.0, 1.0/3.0);
      const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
      vec3 i = floor(v + dot(v, C.yyy));
      vec3 x0 = v - i + dot(i, C.xxx);
      vec3 g = step(x0.yzx, x0.xyz);
      vec3 l = 1.0 - g;
      vec3 i1 = min(g.xyz, l.zxy);
      vec3 i2 = max(g.xyz, l.zxy);
      vec3 x1 = x0 - i1 + C.xxx;
      vec3 x2 = x0 - i2 + 2.0 * C.xxx;
      vec3 x3 = x0 - 1.0 + 3.0 * C.xxx;
      i = mod(i, 289.0);
      vec4 p = permute(permute(permute(i.z + vec4(0.0, i1.z, i2.z, 1.0)) + i.y + vec4(0.0, i1.y, i2.y, 1.0)) + i.x + vec4(0.0, i1.x, i2.x, 1.0));
      float n_ = 1.0/7.0;
      vec3 ns = n_ * D.wyz - D.xzx;
      vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
      vec4 x_ = floor(j * ns.z);
      vec4 y_ = floor(j - 7.0 * x_);
      vec4 x = x_ * ns.x + ns.yyyy;
      vec4 y = y_ * ns.x + ns.yyyy;
      vec4 h = 1.0 - abs(x) - abs(y);
      vec4 b0 = vec4(x.xy, y.xy);
      vec4 b1 = vec4(x.zw, y.zw);
      vec4 s0 = floor(b0)*2.0 + 1.0;
      vec4 s1 = floor(b1)*2.0 + 1.0;
      vec4 sh = -step(h, vec4(0.0));
      vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;
      vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;
      vec3 p0 = vec3(a0.xy, h.x);
      vec3 p1 = vec3(a0.zw, h.y);
      vec3 p2 = vec3(a1.xy, h.z);
      vec3 p3 = vec3(a1.zw, h.w);
      vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2,p2), dot(p3,p3)));
      p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
      vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
      m = m * m;
      return 42.0 * dot(m*m, vec4(dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3)));
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / uRes;
      float aspect = uRes.x / uRes.y;
      vec2 p = vec2(uv.x * aspect, uv.y);
      vec2 m = vec2(uMouse.x * aspect, uMouse.y);

      // Slow drift: two octaves of noise bend the lines
      float n = snoise(vec3(p.x * 1.1, p.y * 0.9, uTime * 0.07)) * 0.6
              + snoise(vec3(p.x * 2.6, p.y * 2.0, uTime * 0.11)) * 0.25;

      // The pointer opens a lens: lines nearby are pushed away from it
      vec2 d = p - m;
      float r = length(d);
      float lens = exp(-r * r * 7.0) * uPush;
      float y = uv.y + n * 0.035 + sign(d.y) * lens * 0.11;

      float count = clamp(uRes.y / 11.0, 50.0, 110.0);
      float f = y * count;
      float w = fwidth(f);
      float thickness = 0.06 + lens * 0.22;
      float dl = abs(fract(f + 0.5) - 0.5); // distance to the nearest line
      float line = 1.0 - smoothstep(thickness, thickness + w * 1.2, dl);

      // Reveal sweeps in from the left on load
      float reveal = smoothstep(uReveal - 0.15, uReveal, uv.x + (1.0 - uv.y) * 0.1);
      line *= 1.0 - reveal;

      float glow = 0.55 + 0.45 * smoothstep(1.1, 0.0, r);
      gl_FragColor = vec4(mix(uBg, uLine, line * glow), 1.0);
    }
  `

  function mount(canvas: HTMLCanvasElement) {
    if (canvas.dataset.mounted) return
    canvas.dataset.mounted = '1'
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches

    let renderer: THREE.WebGLRenderer
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: false, powerPreference: 'high-performance' })
    } catch {
      canvas.classList.add('no-webgl')
      return
    }
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2))
    const scene = new THREE.Scene()
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1)
    const uniforms = {
      uRes: { value: new THREE.Vector2() },
      uTime: { value: 0 },
      uMouse: { value: new THREE.Vector2(0.7, 0.55) },
      uPush: { value: 0 },
      uReveal: { value: reduced ? 2 : -0.2 },
      uBg: { value: new THREE.Color('#2e2bff') },
      uLine: { value: new THREE.Color('#ffffff') },
    }
    const material = new THREE.ShaderMaterial({ fragmentShader: FRAG, vertexShader: 'void main(){ gl_Position = vec4(position, 1.0); }', uniforms })
    scene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material))

    const size = () => {
      const { clientWidth: w, clientHeight: h } = canvas
      renderer.setSize(w, h, false)
      uniforms.uRes.value.set(w * renderer.getPixelRatio(), h * renderer.getPixelRatio())
    }
    size()
    const ro = new ResizeObserver(size)
    ro.observe(canvas)

    // Pointer target, eased every frame so the lens glides
    const target = { x: 0.7, y: 0.55, push: 0 }
    const onMove = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect()
      target.x = (e.clientX - r.left) / r.width
      target.y = 1 - (e.clientY - r.top) / r.height
      target.push = 1
    }
    const onLeave = () => { target.push = 0 }
    canvas.parentElement?.addEventListener('pointermove', onMove)
    canvas.parentElement?.addEventListener('pointerleave', onLeave)

    // Only draw while the hero is on screen
    let visible = true
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting })
    io.observe(canvas)

    let last = performance.now()
    let raf = 0
    const frame = (now = performance.now()) => {
      raf = requestAnimationFrame(frame)
      const dt = Math.min((now - last) / 1000, 0.05)
      last = now
      if (!visible || document.hidden) return
      if (!reduced) uniforms.uTime.value += dt
      const m = uniforms.uMouse.value
      m.x += (target.x - m.x) * 0.08
      m.y += (target.y - m.y) * 0.08
      uniforms.uPush.value += (target.push - uniforms.uPush.value) * 0.05
      if (uniforms.uReveal.value < 1.4) uniforms.uReveal.value += dt * 1.1
      renderer.render(scene, camera)
    }
    frame()

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf); ro.disconnect(); io.disconnect(); renderer.dispose(); material.dispose()
    }, { once: true })
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLCanvasElement>('[data-line-field]').forEach(mount)
  })
</script>
